# App
# NEXT_PUBLIC_SITE_URL is the public origin the app is served from. It is
# required in production builds (Vercel production or NODE_ENV=production);
# development falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=AjiraNext
# NEXT_PUBLIC_API_BASE_URL is the public API base URL consumed by the
# marketing + web-app API clients (see src/lib/api/public.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085/v1
NEXT_PUBLIC_API_URL=http://localhost:8085/v1

# Supabase — get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Development helpers (optional — allows bypassing real auth in local dev)
# MOCK_AUTH_ROLE=job_seeker
